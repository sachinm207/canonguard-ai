# =====================================================================
# CanonGuard AI - Environment Configuration
# Target Track: ClickHouse Partner Track ($7,500 1st Prize)
# =====================================================================

# ---------------------------------------------------------------------
# 1. ClickHouse Configuration
# ---------------------------------------------------------------------

# Option A: Local ClickHouse (Docker or Standalone)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=canonguard
CLICKHOUSE_SECURE=false

# Option B: ClickHouse Cloud Production (Get free trial at https://clickhouse.cloud)
# CLICKHOUSE_HOST=your-cluster-id.us-east-1.aws.clickhouse.cloud
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=your-secure-password
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_SECURE=true

# ---------------------------------------------------------------------
# 2. Google Gemini API Configuration
# ---------------------------------------------------------------------
# Required for Batch Screenplay Ingestion (Method B) & Custom Universe Generation
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# 3. Application Engine Tuning
# ---------------------------------------------------------------------
UNIVERSE_ID=CHRONOVERSE
DEBOUNCE_MS=350
STRICT_MODE=true
